# ============================================================
# AI Job Portal — Docker & Local Environment Variables Example
# Copy this file to .env and fill in your actual credentials:
#   cp .env.example .env
# ============================================================

# === PostgreSQL Database ===
POSTGRES_DB=ai_job_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password

# === Backend — Database URL ===
# For Docker Compose:
DATABASE_URL=postgresql://postgres:your_secure_postgres_password@db:5432/ai_job_portal
# For Local Run (without Docker):
# DATABASE_URL=postgresql://postgres:your_secure_postgres_password@localhost:5433/ai_job_portal

# === Backend — JWT Security ===
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === Backend — AI / LLM Configuration ===
# Get your DeepSeek API key at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# === Backend — Application Settings ===
APP_NAME=AI Job Portal
DEBUG=false
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# === Backend — Google OAuth 2.0 (Optional) ===
# Set up at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
