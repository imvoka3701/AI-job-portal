# ============================================================
# AI Job Portal — Environment Configuration Example (.env.example)
#
# Usage:
#   1. Copy this file to .env:
#      cp .env.example .env   (Linux/macOS/Git Bash)
#      copy .env.example .env (Windows CMD)
#   2. Fill in your actual values (especially DEEPSEEK_API_KEY).
#   3. Run with Docker Compose:
#      docker compose up -d --build
# ============================================================

# ============================================================
# 1. PostgreSQL Database Configuration
# ============================================================
POSTGRES_DB=ai_job_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me

# Backend connection string:
# - For Docker Compose (db service):
DATABASE_URL=postgresql://postgres:postgres_secure_password_change_me@db:5432/ai_job_portal
# - For Local Run (connecting from host to exposed Docker port 5433):
# DATABASE_URL=postgresql://postgres:postgres_secure_password_change_me@localhost:5433/ai_job_portal

# ============================================================
# 2. Backend Security & JWT Authentication
# ============================================================
SECRET_KEY=super-secret-jwt-key-please-change-in-production-random-string-123456
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================
# 3. AI / LLM Integration (DeepSeek API)
# ============================================================
# Lấy API Key tại: https://platform.deepseek.com/
# Cần thiết cho tính năng: Chấm điểm CV, phân tích khớp lệnh, gợi ý kỹ năng, phỏng vấn AI
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ============================================================
# 4. Web Application & CORS Configuration
# ============================================================
APP_NAME=AI Job Portal
DEBUG=false
LOG_LEVEL=INFO
# Cấu hình AI Audit Log: để trống để log ra stdout (Docker), hoặc đặt đường dẫn file jsonl
# AI_AUDIT_LOG_FILE=/var/log/ai_audit.jsonl
AI_AUDIT_LOG_FILE=

# Frontend URLs & CORS Origins (phân tách bởi dấu phẩy)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FRONTEND_URL=http://localhost:3000

# ============================================================
# 5. Transactional Email / SMTP Configuration (Tùy chọn)
# ============================================================
# Dùng để gửi email thông báo phỏng vấn, kết quả ứng tuyển, OTP
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aijobportal.vn
SMTP_FROM_NAME=AI Job Portal
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_BOUNCE_WEBHOOK_SECRET=

# ============================================================
# 6. Google OAuth 2.0 Login (Tùy chọn)
# ============================================================
# Tạo Credentials tại: https://console.cloud.google.com/apis/credentials
# Authorized Redirect URI: http://localhost:8000/auth/google/callback (hoặc qua domain của bạn)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# ============================================================
# 7. Sentry Error Tracking (Tùy chọn)
# ============================================================
SENTRY_DSN=
