# ============================================================
# AI Job Portal — Backend Local Environment (.env.example)
# ============================================================

# === Database ===
# Local direct connection (Default port 5432 or exposed docker port 5433):
DATABASE_URL=postgresql://postgres:postgres_secure_password_change_me@localhost:5433/ai_job_portal

# === JWT Security ===
SECRET_KEY=your-super-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# === AI / LLM ===
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# === App Settings ===
APP_NAME=AI Job Portal
DEBUG=false
LOG_LEVEL=INFO
AI_AUDIT_LOG_FILE=
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173

# === Transactional email / SMTP (Optional) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@aijobportal.vn
SMTP_FROM_NAME=AI Job Portal
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_BOUNCE_WEBHOOK_SECRET=

# === Google OAuth 2.0 (Optional) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# === Sentry (Optional) ===
SENTRY_DSN=
