# ============================================================
# AI Job Portal — Docker Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.docker .env
# Then run:
#   docker compose up --build
# ============================================================

# === PostgreSQL ===
POSTGRES_DB=ai_job_portal
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_change_me

# === Backend — Database ===
# Points to the Docker 'db' service (NOT localhost)
DATABASE_URL=postgresql://postgres:postgres_secure_password_change_me@db:5432/ai_job_portal

# === Backend — JWT ===
SECRET_KEY=docker-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# === Backend — AI / LLM ===
# Get your key at https://platform.deepseek.com/
# ⚠️  Must match the key in backend/.env for consistent AI results
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# === Backend — App ===
APP_NAME=AI Job Portal
DEBUG=false

# === Backend — Logging ===
# Log level for the application: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# AI audit log file path (inside container).
# When set, AI audit events are written as JSON lines to this file (rotated at 50 MB).
# Leave empty to stream audit logs to stdout (default for Docker).
# Example: AI_AUDIT_LOG_FILE=/var/log/ai_audit.jsonl
AI_AUDIT_LOG_FILE=

# ⚠️  Docker frontend runs on port 3000 (Nginx), NOT 5173 (Vite dev)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# === Backend — Transactional email / SMTP (optional) ===
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=AI Job Portal
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
EMAIL_BOUNCE_WEBHOOK_SECRET=

# === Backend — Google OAuth (optional) ===
# Set up at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI must include: http://localhost:8000/auth/google/callback
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
